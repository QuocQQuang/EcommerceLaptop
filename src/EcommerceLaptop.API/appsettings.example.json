{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=EcommerceLaptop;Trusted_Connection=true;MultipleActiveResultSets=true",
        "Redis": "localhost:6379"
    },
    "Elasticsearch": {
        "ConnectionString": "http://localhost:9200",
        "IndexName": "products",
        "BulkIndexingBatchSize": 100,
        "IndexingInterval": "00:15:00"
    },
    "Search": {
        "IndexingDelayMinutes": 60,
        "IndexingBatchSize": 50,
        "FullReindexIntervalHours": 24,
        "FullReindexBatchSize": 100
    },
    "Jwt": {
        "SecretKey": "YOUR_JWT_SECRET_KEY_MINIMUM_256_BITS",
        "Issuer": "EcommerceLaptop",
        "Audience": "EcommerceLaptopUsers",
        "ExpiryInMinutes": 60
    },
    "AdminJwt": {
        "SecretKey": "YOUR_ADMIN_JWT_SECRET_KEY_MINIMUM_256_BITS",
        "Issuer": "EcommerceLaptop",
        "Audience": "EcommerceLaptopAdmins",
        "ExpiryInMinutes": 120,
        "RefreshTokenExpiryInDays": 7
    },
