    "EmbeddingConfig": {
        "Provider": "Lm",
        "ModelId": "text-embedding-qwen3-embedding-0.6b",
        "Dimensions": 1024,
        "ApiKey": "YOUR_EMBEDDING_API_KEY",
        "BaseUrl": "http://127.0.0.1:1234/v1"
    },
    "EmailSettings": {
        "SmtpSettings": {
            "Host": "smtp.gmail.com",
            "Port": 587,
            "EnableSsl": true,
            "UseDefaultCredentials": false,
            "Username": "your-email@gmail.com",
            "Password": "YOUR_APP_PASSWORD",
            "TimeoutSeconds": 30
        },
        "GmailSettings": {
            "ClientId": "YOUR_GMAIL_CLIENT_ID",
            "ClientSecret": "YOUR_GMAIL_CLIENT_SECRET",
            "RedirectUri": "urn:ietf:wg:oauth:2.0:oob",
            "EnableOAuth2": false,
            "Scopes": [
                "https://www.googleapis.com/auth/gmail.send",
                "https://www.googleapis.com/auth/gmail.compose"
            ]
        },
        "SenderSettings": {
            "Name": "Your Company Name",
            "Email": "noreply@yourdomain.com",
            "ReplyTo": "support@yourdomain.com",
            "NoReplyEmail": "noreply@yourdomain.com",
            "CompanyName": "Your Company Name",
            "CompanyAddress": "123 Your Address",
            "CompanyPhone": "Your Phone",
            "CompanyWebsite": "https://www.yourdomain.com"
        },
        "Templates": {
            "BasePath": "EmailTemplates",
            "DefaultLanguage": "vi",
            "SupportedLanguages": [
                "vi",
                "en"
            ],
            "WelcomeTemplate": "WelcomeEmailTemplate.html",
            "PasswordResetTemplate": "PasswordResetTemplate.html",
            "OrderConfirmationTemplate": "OrderConfirmationTemplate.html",
            "OrderShippedTemplate": "OrderShippedTemplate.html",
            "AccountActivationTemplate": "AccountActivationTemplate.html"
        },
        "RateLimiting": {
            "MaxEmailsPerMinute": 50,
            "MaxEmailsPerHour": 300,
            "MaxEmailsPerDay": 1000,
            "EnableRateLimiting": true,
            "RateLimitCooldownMinutes": 60,
            "EnableDailyQuotaCheck": true
        },
        "Security": {
            "EnableEmailEncryption": true,
            "TokenExpirationMinutes": 1440,
            "OtpExpirationMinutes": 10,
            "MaxRetryAttempts": 3,
            "EncryptionKey": "YOUR_32_CHAR_ENCRYPTION_KEY_HERE",
            "EnableContentValidation": true,
            "BlockSuspiciousEmails": true,
            "LogSecurityEvents": true
        },
        "Queue": {
            "EnableQueue": true,
            "MaxRetries": 5,
            "RetryDelaySeconds": 30,
            "BatchSize": 10,
            "PriorityProcessing": true,
            "HighPriorityBatchSize": 5,
            "ProcessingIntervalSeconds": 10,
            "EnableDeadLetterQueue": true,
            "DeadLetterRetentionDays": 7
        },
        "Monitoring": {
            "EnableEmailTracking": true,
            "EnableDeliveryReports": true,
            "EnablePerformanceMetrics": true,
            "LogLevel": "Information",
            "MetricsRetentionDays": 30
        },
        "Backup": {
            "EnableEmailBackup": false,
            "BackupPath": "EmailBackups",
            "RetentionDays": 30,
            "CompressBackups": true
        }
    },
    "PasswordReset": {
        "ExpiryMinutes": 15,
        "MaxAttemptsPerHour": 30,
        "MaxAttemptsPerDay": 550,
        "CooldownMinutes": 10,
        "TokenLength": 64,
        "CleanupIntervalHours": 1,
        "Security": {
            "EnableRateLimiting": true,
            "EnableIpBlocking": true,
            "BlockDurationMinutes": 1440,
            "MaxFailedAttemptsBeforeBlock": 10,
            "EnableAuditLogging": true,
            "LogSecurityEvents": true
        },
        "Notifications": {
            "NotifyOnPasswordChange": true,
            "NotifyOnMultipleFailedAttempts": true,
            "NotifyAdminOnSuspiciousActivity": true
        }
    },
    "Frontend": {
        "BaseUrl": "https://your-frontend-domain.com"
    },
    "ImgBB": {
        "ApiKey": "YOUR_IMGBB_API_KEY",
        "ApiUrl": "https://api.imgbb.com/1/upload",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "MaxFileSizeBytes": 33554432,
        "AllowedMimeTypes": [
            "image/jpeg",
            "image/jpg",
            "image/png",
            "image/gif",
            "image/webp",
            "image/bmp"
        ],
        "ExpirationSeconds": 0
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "None",
            "EcommerceLaptop.Infrastructure.Services": "Information"
        }
    },
    "AllowedHosts": "*"
